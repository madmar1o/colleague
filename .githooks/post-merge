#!/bin/sh
# post-merge: слияние/пул — событие + фоновый пересчёт SonarQube.
LOG="/c/open-project/Colleague Project/notes/git-events.log"
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
HEAD=$(git rev-parse --short HEAD 2>/dev/null)
echo "$(date -Iseconds) event=post-merge branch=$BRANCH head=$HEAD msg=\"$1\"" >> "$LOG"
powershell.exe -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass \
  -File 'C:\open-project\Colleague Project\tools\sonar_track.ps1' >/dev/null 2>&1 &
exit 0
