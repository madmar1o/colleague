#!/bin/sh
# post-checkout: переключение ветки (flag=1) — только записываем событие,
# скан на checkout не запускаем (дешевле, и HEAD тот же).
if [ "$3" = "1" ]; then
  LOG="/c/open-project/Colleague Project/notes/git-events.log"
  OLD=$(git rev-parse --short "$1" 2>/dev/null)
  NEW=$(git rev-parse --short "$2" 2>/dev/null)
  BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  echo "$(date -Iseconds) event=post-checkout branch=$BRANCH from=$OLD to=$NEW" >> "$LOG"
fi
exit 0
